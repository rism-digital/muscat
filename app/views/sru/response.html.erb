<% if @sru.error_code %>
  <%= render partial: 'error' %>
<% elsif @sru.operation == 'explain' %>
  <%= render partial: 'explain' %>
<% elsif @sru.operation == 'scan' %>
  <%= render partial: 'scan' %>
<% elsif @sru.schema == 'html' %>
  <%= render partial: 'result_h' %>
<% else %>
  <%= render partial: 'result' %>
<% end %>

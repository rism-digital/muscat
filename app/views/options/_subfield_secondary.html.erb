<%- has_links_to = params.has_key?("has_links_to") ? params['has_links_to'] : false %>
<%- preserve_foreign_value = params.has_key?("preserve_foreign_value") ? params['preserve_foreign_value'] : false %>
<%- master = has_links_to ? subfield : @item.marc.config.get_master(tag_name) %>
<% 
	# links_to is a special case where we create an auth file but not the id
	# so we just fill in the master subfield with the "data" field
	# Similarly, if the the field is NOT a linked (foreign) field, we need
	# to have the master equals to the data subfield
	if has_links_to == true || !@item.marc.config.is_foreign?(tag_name, master)
		marc_subfield_m = marc_subfield || MarcNode.new(@item.marc.get_model)
	else
		marc_subfield_m = marc_tag.fetch_first_by_tag(master) || MarcNode.new(@item.marc.get_model)
		if marc_subfield_m&.content == "IMPORT-NEW"
			marc_subfield_m.content = ""
			force_new = true
		end
	end 

	triggers = nil
	if params.include?("trigger") && params["trigger"].is_a?(Array)
		triggers = params["trigger"].to_json.html_safe
	end

%>

<%- no_new = params.include?("no_new") ? params["no_new"] : false %>
<%- ac_path = send(params['type'] + "_default_autocomplete")%>
<%- field = params.has_key?("field") ? params['field'] : "id" %>
<%- allow_new = params.has_key?("allow_new") ? params['allow_new'] : false %>

<%- only_new_window = params.has_key?("only_new_window") ? true : false %>
<%- read_only = params.has_key?("read_only") && !(@current_user.has_role?(:editor) || @current_user.has_role?(:admin)) ? true : false %>
<%# validation plugin REQUIRES a name. Make it random as we never call it elsewhere %>
<%- check_name = "confirmation_uniq_" + SecureRandom.hex(5)%>

<% 
# Validate on the MASTER subfield, because it can be different from the DISPLAY subfield!
# NOTE Secondary subfields DO NOT SUPPORT WARNINGS.
	validate_marker = ""
	validate_level = ""

	validate_class_master, unique_name_master = EditorValidation::generate_subtag_class_and_unique_name(tag_name, master)
	validate_class_subfield, _ = EditorValidation::generate_subtag_class_and_unique_name(tag_name, subfield)

	if @editor_validation && @editor_validation&.validate_subtag?(tag_name, master, @item)
		validate_marker = "validating"
		validate_level = "warning" if @editor_validation.is_warning?(tag_name, subfield)
	end
	
	# In the case the same subfield is used for master and display
	# Only one needs to be validated
	validate_class_subfield += "_bis" if validate_class_subfield.present? && validate_class_subfield == validate_class_master
%>

<%
	# We need to import data, simulate the
	# "confirm" checkbox
	if force_new
		validate_class_master = ""
		hidden_serialize = ""
	else
		hidden_serialize = "serialize_marc"
	end
%>

<!--input type="hidden" class="autocomplete_target <%=hidden_serialize%> <%=validate_class_master%>" data-tag="<%=tag_name%>" data-subfield="<%=master%>" data-field="<%=field%>" value="<%=marc_subfield_m.content %>" <%=unique_name_master%> data-allow-new="<%=allow_new%>" data-has-links-to="<%=has_links_to%>" data-preserve-foreign-value="<%=preserve_foreign_value%>" data-validate-level="<%=validate_level%>"-->

<%= hidden_field_tag(
  unique_name_master,
  marc_subfield_m.content,
  class: ["autocomplete_target", hidden_serialize, validate_class_master].compact.join(" "),
  data: {
    tag: tag_name,
    subfield: master,
    field: field,
    allow_new: allow_new,
    has_links_to: has_links_to,
    preserve_foreign_value: preserve_foreign_value,
    validate_level: validate_level
  }
) %>

<%
options = {
	:size => 75, 
	:class => "marc_editor_hotkey autocomplete_new_window #{validate_class_subfield} #{validate_marker}",
	:"data-subfield"=>"#{subfield}",
	:"data-field"=>"#{tag_name}",
	:"data-validate-level" => validate_level,
	:"min-length" => 1
}
	## When we iport data show it as if the falidation is applied
	options[:class] += " serialize_marc new_autocomplete" if force_new
	options[:"data-trigger"] = triggers if triggers
	options[:disabled] = "disabled" if only_new_window || read_only || @restricted == 'disabled'
%>

<%
# Duplicating a tag from the editor will add its own junk to the name, it is ok since the name is not used
# see tag_header_events.js
%>
<%= autocomplete_field_tag "#{tag_name}#{subfield}-#{SecureRandom.hex(5)}", marc_subfield.looked_up_content, ac_path, options %>

<%if force_new %>
<div class="checkbox_confirmation new_autocomplete">
<% else %>
<div class="checkbox_confirmation" style="display: none;">
<% end %>
	<%if force_new%>
		<input class="creation_checkbox" type="checkbox" data-check="true" name="<%=check_name%>" checked="true"/>
	<% else %>
		<input class="creation_checkbox" type="checkbox" data-check="false" name="<%=check_name%>"/>
	<%end%>
	<span id="<%=check_name%>-label">Confirm the insertion of a new value</span>
</div>

<%
	if @editor_validation && @editor_validation.validate_subtag?(tag_name, subfield, @item)
		validate_class, unique_name = EditorValidation::generate_subtag_class_and_unique_name(tag_name, subfield)
		name_tag = raw "name=\"#{unique_name}\""
		validate_marker = "validating"
		validate_level = "warning" if @editor_validation.is_warning?(tag_name, subfield)
	else
		validate_class = ""
	end

	tag_params = @editor_profile.options_config[tag_name]["tag_params"]
%>

<div class="edtf-subfield marc_editor_pae_textbox">
  <input type="text" class="input-edtf subfield_entry serialize_marc marc_editor_hotkey <%=validate_class%> <%=validate_marker%>" data-tag="<%=tag_name%>" data-subfield="<%=subfield%>" spellcheck="false" value="<%= h marc_subfield.content %>" />

  <div class="edtf-message"></div>
  <div class="edtf-error"></div>
</div>

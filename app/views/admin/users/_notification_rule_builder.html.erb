<%
  builder_config = {
    models: NotificationMatcher::ALLOWED_MODELS + ["all"],
    fields: NotificationMatcher::ALLOWED_PROPERTIES,
    operators: %w[equals starts_with ends_with contains glob],
    exact_fields: NotificationMatcher::EXACT_PROPERTIES,
    labels: {
      add_rule: I18n.t("notifications.rule_builder.add_rule", default: "Add rule"),
      add_condition: I18n.t("notifications.rule_builder.add_condition", default: "Add condition"),
      duplicate: I18n.t("notifications.rule_builder.duplicate", default: "Duplicate"),
      remove: I18n.t("notifications.rule_builder.remove", default: "Remove"),
      edit: I18n.t("notifications.rule_builder.edit", default: "Edit"),
      close: I18n.t("notifications.rule_builder.close", default: "Close"),
      expand_all: I18n.t("notifications.rule_builder.expand_all", default: "Expand all"),
      collapse_all: I18n.t("notifications.rule_builder.collapse_all", default: "Collapse all"),
      rules: I18n.t("notifications.rule_builder.rules", default: "rules"),
      when: I18n.t("notifications.rule_builder.when", default: "When the record type is"),
      where: I18n.t("notifications.rule_builder.where", default: "WHERE"),
      and: I18n.t("notifications.rule_builder.and", default: "AND"),
      empty: I18n.t("notifications.rule_builder.empty", default: "No notification rules yet. Add a rule to get started."),
      rule: I18n.t("notifications.rule_builder.rule", default: "Rule"),
      any_record: I18n.t("notifications.rule_builder.any_record", default: "Any record"),
      any_condition: I18n.t("notifications.rule_builder.any_condition", default: "Any modification"),
      any_modified: I18n.t("notifications.rule_builder.any_modified", model: "__MODEL__", default: "Any __MODEL__ modified"),
      exclude_own: I18n.t("notifications.rule_builder.exclude_own", default: "Do not notify me about my own changes"),
      invalid_value: I18n.t("notifications.rule_builder.invalid_value", default: "Values cannot contain a colon or double quote.")
    },
    endpoints: {
      user: autocomplete_notification_user_admin_users_path,
      institution: autocomplete_institution_siglum_admin_institutions_path,
      person: autocomplete_person_full_name_admin_people_path
    }
  }
%>

<li class="input notification-rule-builder-input">
  <div
    class="notification-rule-builder"
    data-notification-rule-builder
    data-config="<%= builder_config.to_json %>">
    <%= hidden_field_tag "user[notifications]", @user.notifications,
                         data: { notification_rules_legacy: true } %>

    <div class="notification-rule-builder__intro">
      <p><%= I18n.t("notifications.rule_builder.help", default: "Choose what should trigger a notification.") %></p>
      <p class="notification-rule-builder__logic"><%= I18n.t("notifications.rule_builder.logic", default: "Conditions inside a rule are joined with AND. Separate rules are alternatives (OR).") %></p>
    </div>

    <div class="notification-rule-builder__toolbar">
      <span class="notification-rule-builder__count" data-rule-count></span>
      <div class="notification-rule-builder__toolbar-actions">
        <button type="button" class="button" data-expand-all>
          <%= I18n.t("notifications.rule_builder.expand_all", default: "Expand all") %>
        </button>
        <button type="button" class="button" data-collapse-all>
          <%= I18n.t("notifications.rule_builder.collapse_all", default: "Collapse all") %>
        </button>
      </div>
    </div>

    <div class="notification-rule-builder__rules" data-rule-list></div>

    <button type="button" class="button notification-rule-builder__add-rule" data-add-rule>
      <%= I18n.t("notifications.rule_builder.add_rule", default: "Add rule") %>
    </button>

    <details class="notification-rule-builder__advanced">
      <summary><%= I18n.t("notifications.rule_builder.advanced", default: "Advanced and imported rules") %></summary>
      <p><%= I18n.t("notifications.rule_builder.advanced_help", default: "Rules the builder cannot safely convert are kept here. The preview shows the legacy rules Muscat will continue to use.") %></p>

      <label for="notification_rules_legacy_lines">
        <%= I18n.t("notifications.rule_builder.unconverted_rules", default: "Unconverted legacy rules") %>
      </label>
      <textarea id="notification_rules_legacy_lines" rows="4" data-legacy-lines></textarea>

      <label for="notification_rules_legacy_preview">
        <%= I18n.t("notifications.rule_builder.legacy_preview", default: "Generated legacy rules (read-only)") %>
      </label>
      <textarea id="notification_rules_legacy_preview" rows="6" readonly data-legacy-preview></textarea>
    </details>

    <noscript>
      <p class="notification-rule-builder__error"><%= I18n.t("notifications.rule_builder.javascript_required", default: "JavaScript is required to edit notification rules visually.") %></p>
    </noscript>
  </div>
</li>

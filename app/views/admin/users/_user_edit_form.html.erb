 <% action = params[:action] == "new" ? "new" : "edit" %>
 <% form_id = "#{action}_user" %>
 <%= semantic_form_for [:admin, @user], builder: ActiveAdmin::FormBuilder, :html => {:id => form_id } do |f| %>
   <%= f.semantic_errors(*f.object.errors.attribute_names) if f.object.errors.any? %>
   <% unless @user.persisted? %>
     <p><%= I18n.t("users.invitation.help") %></p>
   <% end %>
   
     <%= f.inputs I18n.t(:user_details) do %>
      <% if can? :manage, User %>
        <%= f.input :disabled %>
      <% end %>
       <%if can? :update, User %>
        <%= f.input :username,
          input_html: { id: "user_username" },
          hint: link_to("autogen username", "#", id: "autogen_username") %>
         <%= f.input :name, input_html: { id: "user_name" } %>
         <%= f.input :email %>
       <% end %>
      
       <% if can?(:update, @user) %>
         <%= f.input :password, required: false, hint: (@user.new_record? ? I18n.t("users.password_creation_hint") : nil) %>
         <%= f.input :password_confirmation, required: false %>
       <% end %>
       <% if can? :manage, User %>
         <%= f.input :workgroups,
                    as: :select,
                    multiple: true,
                    collection: Workgroup.shared.sort_by(&:name) %>
         <%= f.input :roles, as: :select, multiple: false, collection: Role.all %>
         <%= f.input :preference_wf_stage, as: :select, multiple: false, collection: [:inprogress, :published] %>
       <% end %>
     <% end %>

     <% if @user.persisted? && can?(:update, @user) %>
       <%= f.inputs I18n.t("notifications.notifications") do %>
         <%= f.input :notification_type,
                     label: I18n.t("notifications.cadence"),
                     as: :select,
                     multiple: false,
                     include_blank: false,
                     collection: [:none, :every, :daily, :weekly].collect { |value|
                       [I18n.t("notifications.#{value}"), value == :none ? nil : value]
                     } %>
         <% if can? :manage, User %>
           <%= f.input :notification_email %>
         <% end %>
         <%= render "admin/users/notification_rule_builder", f: f %>
       <% end %>
     <% end %>
<% end %>

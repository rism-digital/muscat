<% resource = local_assigns.fetch(:resource) %>
<% comment_form_url = local_assigns.fetch(:comment_form_url) %>
<% users_url = local_assigns.fetch(:users_url, "/admin/users/list") %>

<%= semantic_form_for ActiveAdmin::Comment.new, url: comment_form_url, builder: ActiveAdmin::FormBuilder, html: { class: "active_admin_comment" } do |f| %>
  <%= f.inputs do %>
    <%= f.input :resource_type, as: :hidden, input_html: { value: ActiveAdmin::Comment.resource_type(resource) } %>
    <%= f.input :resource_id, as: :hidden, input_html: { value: resource.id } %>

    <%= render partial: "shared/mention_editor", locals: {
      name: "#{f.object_name}[body]",
      value: f.object.body,
      users_url: users_url,
      show_hint: false,
      help_text: I18n.t("active_admin.comments.comments_help"),
      wrapper_class: "active-admin-comment-editor"
    } %>
  <% end %>

  <%= f.actions do %>
    <%= f.action :submit, label: I18n.t("active_admin.comments.add") %>
  <% end %>
<% end %>

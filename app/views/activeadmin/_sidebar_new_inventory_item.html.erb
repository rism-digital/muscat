<ul>
  <%= form_with url: new_admin_inventory_item_path,
                method: :get,
                local: true,
                html: { id: "create-inventory-form" } do |f| %>

    <%= hidden_field_tag :prototype_source_id, resource.id %>

    <div class="input">
      <%= label_tag :source_id, "Inventory Source or Edition to attach this item to" %>

      <%= text_field_tag :source_id,
                         "",
                         id: "inventory-source-id",
                         data: { inventory_check_url: "/admin/sources/:id/is_inventory" },
                         style: "width: 100%;" %>

      <p id="inventory-source-message" style="display: none;"></p>
    </div>

    <div class="actions">
      <%= submit_tag "Create Inventory",
                     id: "create-inventory-submit",
                     disabled: true,
                     style: "opacity: 0.5; cursor: not-allowed;" %>
    </div>
  <% end %>
</ul>